{
  "name": "watchlist",
  "private": true,
  "version": "0.1.0",
  "description": "Portfolio Tracker: lista de vigilancia y cartera de acciones, ETF y fondos",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev -w @watchlist/server\" \"npm:dev -w @watchlist/web\"",
    "build": "npm run build -w @watchlist/web",
    "start": "npm run start -w @watchlist/server",
    "serve": "npm run start -w @watchlist/server",
    "seed": "npm run seed -w @watchlist/server --",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared && tsc -p apps/server && tsc -p apps/web",
    "claves-push": "npx web-push generate-vapid-keys"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
